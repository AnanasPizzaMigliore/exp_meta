<?xml version="1.0" encoding="utf-8" ?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">

    <ImageButton
        android:id="@+id/camera_play_btn"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/ic_play_circle_24"
        android:contentDescription="@string/camera_controls_button_description"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnSelectFolder"
        app:layout_constraintHorizontal_chainStyle="packed" />

    <Button
        android:id="@+id/btnSelectFolder"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:layout_marginStart="12dp"
        android:text="Benchmark"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnGatedAblation"
        app:layout_constraintStart_toEndOf="@id/camera_play_btn"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnGatedAblation"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:layout_marginStart="12dp"
        android:text="Gated"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnContinuousAblation"
        app:layout_constraintStart_toEndOf="@id/btnSelectFolder"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnContinuousAblation"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:layout_marginStart="12dp"
        android:text="Continuous"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnGatedAblation"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
